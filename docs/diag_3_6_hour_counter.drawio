        </mxCell>

        <mxCell id="r_main" parent="b_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Thanh ghi chính: r_hour[4:0]&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#2e7d32&#39; style=&#39;font-size:10px;&#39;&gt;• Modulo-24 (0..23)&lt;br&gt;• RUN: Tăng theo min_rollover&lt;br&gt;• ADJ: Tăng/Giảm wrap-around&lt;br&gt;• cancel_pulse: Lấy từ r_hour_bak&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="290" y="80" as="geometry" />
        </mxCell>

