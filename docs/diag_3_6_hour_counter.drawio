        <mxCell id="b_box" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#43a047;strokeWidth=1.5;startSize=26;fontFamily=Helvetica;fontSize=11;rounded=1;" value="&lt;b&gt;hour_counter: Sơ đồ khối Modulo-24 &amp;amp; Thanh ghi Snapshot Shadow Rollback&lt;/b&gt;" vertex="1">
