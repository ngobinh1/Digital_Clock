          <mxGeometry height="90" width="220" x="290" y="230" as="geometry" />
        </mxCell>

        <mxCell id="p_out_h" parent="b_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;fontSize=11;" value="&lt;b&gt;h_out[4:0]&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#555&#39;&gt;Giờ: 0..23&lt;/font&gt;" vertex="1">
