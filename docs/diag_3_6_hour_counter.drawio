        </mxCell>
        
        <mxCell id="p_in_grp" parent="b_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#8bc34a;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;TÍN HIỆU ĐIỀU KHIỂN&lt;/b&gt;&lt;br&gt;• adj_mode[1:0]&lt;br&gt;• min_rollover (1-cyc)&lt;br&gt;• sel_pulse (Chốt Snapshot)&lt;br&gt;• up_pulse / down_pulse&lt;br&gt;• cancel_pulse (Rollback)&lt;br&gt;• rstn (Reset)" vertex="1">
