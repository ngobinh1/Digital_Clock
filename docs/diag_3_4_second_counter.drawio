        <mxCell id="r_main" parent="b_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Thanh ghi chính: r_sec[5:0]&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#2e7d32&#39; style=&#39;font-size:10px;&#39;&gt;• Modulo-60 (0..59)&lt;br&gt;• RUN: Tăng theo sec_tick&lt;br&gt;• ADJ: Tăng/Giảm wrap-around&lt;br&gt;• cancel_pulse: Lấy từ r_sec_bak&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="290" y="80" as="geometry" />
        </mxCell>

        <mxCell id="r_bak" parent="b_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Thanh ghi Snapshot: r_sec_bak[5:0]&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#e65100&#39; style=&#39;font-size:10px;&#39;&gt;Chốt giá trị r_sec khi&lt;br&gt;(adj_mode == RUN &amp;amp;&amp;amp; sel_pulse)&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="290" y="230" as="geometry" />
        </mxCell>

        <mxCell id="b_comp" parent="b_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;" value="&lt;b&gt;Tạo cờ tràn sec_rollover&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#01579b&#39; style=&#39;font-size:10px;&#39;&gt;r_sec == 59 &amp;amp;&amp;amp; sec_tick &amp;amp;&amp;amp;&lt;br&gt;(adj_mode == MODE_RUN)&lt;/font&gt;" vertex="1">
