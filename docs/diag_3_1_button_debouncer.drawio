<mxfile host="Electron">
  <diagram name="Page-1" id="diag_button_debouncer_bw">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- CENTER MODULE BOX -->
        <mxCell id="box_module" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" value="button_debouncer" vertex="1">
          <mxGeometry height="220" width="240" x="280" y="60" as="geometry" />
        </mxCell>

        <!-- INPUT ARROWS (LEFT TO RIGHT INTO BOX) -->
        <!-- In 1: clk -->
        <mxCell id="in_clk_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="clk" vertex="1">
          <mxGeometry height="20" width="130" x="140" y="75" as="geometry" />
        </mxCell>
        <mxCell id="in_clk_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="105" as="sourcePoint" />
            <mxPoint x="280" y="105" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- In 2: rstn -->
        <mxCell id="in_rstn_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="rstn" vertex="1">
          <mxGeometry height="20" width="130" x="140" y="140" as="geometry" />
        </mxCell>
        <mxCell id="in_rstn_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="170" as="sourcePoint" />
            <mxPoint x="280" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- In 3: btn_in -->
        <mxCell id="in_btn_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="btn_in" vertex="1">
          <mxGeometry height="20" width="130" x="140" y="205" as="geometry" />
        </mxCell>
        <mxCell id="in_btn_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="235" as="sourcePoint" />
            <mxPoint x="280" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- OUTPUT ARROWS (FROM BOX TO RIGHT) -->
        <!-- Out 1: btn_event -->
        <mxCell id="out_ev_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="btn_event" vertex="1">
          <mxGeometry height="20" width="130" x="530" y="140" as="geometry" />
        </mxCell>
        <mxCell id="out_ev_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="170" as="sourcePoint" />
            <mxPoint x="660" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
