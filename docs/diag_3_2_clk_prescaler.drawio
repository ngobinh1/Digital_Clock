<mxfile host="Electron">
  <diagram name="Page-1" id="diag_clk_prescaler_bw">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- CENTER MODULE BOX -->
        <mxCell id="box_module" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" value="clk_prescaler" vertex="1">
          <mxGeometry height="180" width="240" x="280" y="60" as="geometry" />
        </mxCell>

        <!-- INPUT ARROWS (LEFT TO RIGHT INTO BOX) -->
        <!-- In 1: clk -->
        <mxCell id="in_clk_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="clk" vertex="1">
          <mxGeometry height="20" width="130" x="140" y="80" as="geometry" />
        </mxCell>
        <mxCell id="in_clk_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="110" as="sourcePoint" />
            <mxPoint x="280" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- In 2: rstn -->
        <mxCell id="in_rstn_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="rstn" vertex="1">
          <mxGeometry height="20" width="130" x="140" y="160" as="geometry" />
        </mxCell>
        <mxCell id="in_rstn_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="190" as="sourcePoint" />
            <mxPoint x="280" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- OUTPUT ARROWS (FROM BOX TO RIGHT) -->
        <!-- Out 1: tick_1khz -->
        <mxCell id="out_1k_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="tick_1khz" vertex="1">
          <mxGeometry height="20" width="130" x="530" y="80" as="geometry" />
        </mxCell>
        <mxCell id="out_1k_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="110" as="sourcePoint" />
            <mxPoint x="660" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Out 2: sec_tick -->
        <mxCell id="out_1h_lbl" parent="1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" value="sec_tick" vertex="1">
          <mxGeometry height="20" width="130" x="530" y="160" as="geometry" />
        </mxCell>
        <mxCell id="out_1h_arr" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="190" as="sourcePoint" />
            <mxPoint x="660" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
