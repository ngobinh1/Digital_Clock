<mxfile host="Electron">
  <diagram name="Page-1" id="diag_minute_counter_bw">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="380" math="0" shadow="0">
