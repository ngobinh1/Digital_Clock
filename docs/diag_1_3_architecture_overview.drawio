        </mxCell>

        <mxCell id="b_sec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;" value="&lt;b&gt;second_counter (Modulo-60)&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#274e13&#39; style=&#39;font-size:10px;&#39;&gt;r_sec[5:0] &amp; r_sec_bak[5:0]&lt;br&gt;• RUN: Tăng theo sec_tick&lt;br&gt;• ADJ_SEC: Chỉnh +/-1 (Wrap)&lt;br&gt;• Rollback về snapshot khi cancel&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="230" x="570" y="40" as="geometry" />
