  <diagram name="Page-1" id="hms_spec_diagram">
    <mxGraphModel dx="1294" dy="637" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="680" math="0" shadow="0">
      <root>
