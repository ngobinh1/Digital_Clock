        <mxCell id="b_deb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;" value="&lt;b&gt;button_debouncer (x3)&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#01579b&#39; style=&#39;font-size:10px;&#39;&gt;• 2-FF Synchronizers&lt;br&gt;• 20ms Debounce Counter&lt;br&gt;• Auto-Repeat Pulse Gen&lt;br&gt;• Sinh sel/up/down_pulse&lt;/font&gt;" vertex="1">
          <mxGeometry height="320" width="190" x="250" y="150" as="geometry" />
        </mxCell>
        
        <mxCell id="b_fsm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;" value="&lt;b&gt;mode_controller&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#b45f06&#39; style=&#39;font-size:10px;&#39;&gt;• FSM 4 Trạng thái (RUN/SEC/MIN/HOUR)&lt;br&gt;• Inactivity Timeout 5s (sec_tick)&lt;br&gt;• Sinh adj_mode[1:0] &amp; cancel_pulse&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="250" y="40" as="geometry" />
        </mxCell>

        <mxCell id="b_psc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e7;strokeColor=#ff7043;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;" value="&lt;b&gt;prescaler_1hz&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#990000&#39; style=&#39;font-size:10px;&#39;&gt;Modulo-1,000,000&lt;br&gt;Tạo xung 1Hz (sec_tick)&lt;/font&gt;" vertex="1">
